{% extends 'base.html.twig' %}

{% block title %}Équipes{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/teams.css') }}">
{% endblock %}

{% block body %}
    <div class="head-page mt-8">
        <h3></h3>
        <h2 class="text-3xl  font-bold text-center">Équipes</h2>
        <a class="btn btn-primary" href="{{ path('create_team') }}">Créer équipe</a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="flash-notice" style="color: black; margin-top: 4%; margin-left: auto; padding: 1%; border-radius: 1rem; margin-right: auto; text-align: center; background-color: #27F535; width: 50%;">
            {{ message }}
        </div>
    {% endfor %}

    <section>
        {% for team in viewModel.teamViewModels %}
                <p class="mt-8">
                    {{ team.name }}
                </p>
        {% endfor %}
    </section>

{% endblock %}
