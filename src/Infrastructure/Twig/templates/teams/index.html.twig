{% extends 'base.html.twig' %}

{% block title %}Équipes{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/teams.css') }}">
{% endblock %}

{% block body %}
    <div class="head-page mt-8">
        <h3></h3>
        <h2 class="text-3xl  font-bold text-center">Équipes</h2>
        <a class="btn btn-soft btn-info" href="{{ path('fill_squad_transfermarkt') }}">Remplir effectif via Transfermarkt</a>
        <a class="btn btn-primary" href="{{ path('create_team') }}">Créer équipe</a>
    </div>

    <section>
        {% for team in viewModel.teamViewModels %}
                <p class="mt-8">
                    {{ team.name }}
                </p>
        {% endfor %}
    </section>

{% endblock %}
