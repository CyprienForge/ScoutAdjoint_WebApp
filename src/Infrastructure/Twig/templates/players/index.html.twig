{% extends 'base.html.twig' %}

{% block title %}Joueurs{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/players.css') }}">
{% endblock %}

{% block body %}
    <div class="head-page mt-8">
        <h3></h3>
        <h2 class="text-3xl  font-bold text-center">Joueurs</h2>
        <a class="btn btn-primary" href="{{ path('create_player') }}">Créer joueur</a>
    </div>

    {{ form_start(form, {
        'method': 'get',
        'attr': {'data-controller': 'reset', 'data-reset-target': 'form'}
    }) }}
    <div id="form" class="mt-8">
        <article class="ms-24" style="display: flex; flex-direction: row;">
            {{ form_row(form.first_name) }}
            {{ form_row(form.last_name) }}
            {{ form_row(form.start_birth_date) }}
            {{ form_row(form.end_birth_date) }}
            {{ form_row(form.team) }}
        </article>

        <div class="ms-24 mt-4">
            <label>Positions</label>
            <div style="display: flex; flex-wrap: wrap;">
                {% for choice in form.positions %}
                    <label style="padding-right: 5%;">
                        {{ form_label(choice) }}
                        {{ form_widget(choice) }}
                    </label>
                {% endfor %}
            </div>
        </div>
    </div>

    <div class="mt-8 flex justify-center items-center gap-4 mx-auto w-full max-w-md">
        {{ form_row(form.submit, { 'attr': {'class' : 'btn btn-primary'} }) }}
        <button
            type="button"
            class="btn btn-info btn-soft px-6 py-2 rounded-xl shadow-md"
            data-action="click->reset#reset"
        >
            Vider
        </button>
    </div>
    {{ form_end(form) }}

        <div class="overflow-x-auto mt-8">
            <table class="table table-zebra">
                <thead>
                <tr>
                    <th></th>
                    <th>Nom</th>
                    <th>Prénom</th>
                    <th>Équipe actuelle</th>
                    <th>Poste</th>
                    <th>Date de naissance</th>
                    <th>Fiche</th>
                </tr>
                </thead>
                <tbody>
                {% for player in viewModel.playerViewModels %}
                    <tr>
                        <th>{{ player.positionLoop }}</th>
                        <td>{{ player.lastName }}</td>
                        <td>{{ player.firstName }}</td>
                        <td>{{ player.teamName }}</td>
                        <td>Pas renseigné pour le moment</td>
                        <td>{{ player.birthDate }}</td>
                        <td>
                            <a href="{{ path('details_player', { idPlayer: player.id }) }}">
                                <i class="fa-solid fa-circle-right"></i>
                            </a>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>


    <section id="pagination-section" class="flex justify-center">
        <div class="w-1/4 flex justify-evenly items-center mt-8">
            <a href="{{ path('get_players', { page: viewModel.previousPageNumber } | merge(app.request.query.all)) }}"
               class="btn btn-soft btn-primary"
               data-turbo-frame="players-list">
                Précédent
            </a>
            <h4 class="font-bold">
                Page {{ viewModel.pageNumber }}
            </h4>
            <a href="{{ path('get_players', { page: viewModel.nextPageNumber } | merge(app.request.query.all)) }}"
               class="btn btn-soft btn-primary">
                Suivant
            </a>
        </div>
    </section>


{% endblock %}
