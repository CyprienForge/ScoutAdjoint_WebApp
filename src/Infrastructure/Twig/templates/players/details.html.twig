{% extends 'base.html.twig' %}

{% block title %}Joueurs{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/details_player.css') }}">
{% endblock %}

{% block body %}

    <div class="head">
        <a href="{{ path('get_players') }}" class="btn btn-soft btn-info ms-8 mt-8">
            Retour
        </a>
    </div>

    <div class="flex justify-center">
        <h2 class="text-3xl font-bold">
            {{ viewModel.playerViewModel.firstName }}  {{ viewModel.playerViewModel.lastName }}
        </h2>
    </div>

    {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}
    <section class="flex justify-center" id="player-infos">
        <div class="flex justify-between items-center mt-8 w-3/4">
            <article>
                <label for="{{ form.image.vars.id }}" style="cursor: pointer;">
                    <img
                        src="{{ asset('images/arthur_vignaud.jpg') }}"
                        alt="Photo de {{ viewModel.playerViewModel.firstName }} {{ viewModel.playerViewModel.lastName }}"
                        id="player-photo"
                    />
                </label>
                {{ form_row(form.image) }}
            </article>

            <article>
                <p>{{ form_row(form.last_name) }}</p>
                <p class="mt-4">{{ form_row(form.first_name) }}</p>
                <p class="mt-4">Poste : Non renseigné</p>
            </article>

            <article>
                <p>{{ form_row(form.birth_date) }}</p>
                <p>{{ form_row(form.team) }}</p>
                <p class="mt-4">Nationalité : Non renseigné</p>
            </article>
        </div>

        <div class="mt-6">
            <button type="submit" class="btn btn-primary text-white px-4 py-2 rounded">
                Sauvegarder
            </button>
        </div>
    </section>
    {{ form_end(form) }}


    <section class="mt-24">
        <div class="ms-8">
            <h2 class="text-3xl font-bold">
                <span class="border-b-4 border-red-500">Historique</span> des observations
            </h2>
        </div>
        <div id="observations" class="flex justify-center ms-8 mt-8">
            <table class="table table-zebra">
                <thead>
                <tr>
                    <th></th>
                    <th>Date observation</th>
                    <th>Lieu</th>
                    <th>Équipe</th>
                    <th>Adversaire</th>
                    <th>Numéro</th>
                    <th>Rapport</th>
                </tr>
                </thead>
                <tbody>
                    {% for participation in viewModel.participationViewModels %}
                        <tr>
                            <th>{{ participation.indexLoop }}</th>
                            <td>{{ participation.date }}</td>
                            <td>{{ participation.location }}</td>
                            <td>{{ participation.teamName }}</td>
                            <td>{{ participation.teamOpponentName }}</td>
                            <td>{{ participation.numero }}</td>
                            <td>
                                <a href="{{ path('details_match', { idMatch: participation.idMatch, idTeam: participation.teamId })  }}">
                                    <i class="fa-solid fa-circle-right"></i>
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

{% endblock %}
