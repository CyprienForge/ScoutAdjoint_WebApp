{% extends 'base.html.twig' %}

{% block title %}Créer joueur{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/form.css') }}">
{% endblock %}

{% block body %}
    <section class="form-wrapper bg-base-200">
        <h2>Créer un joueur</h2>

        {{ form_start(form, {'attr': {'class': 'player-form'}}) }}
        <div class="form-grid">
            <div class="form-group">
                {{ form_label(form.firstName) }}
                {{ form_widget(form.firstName, {'attr': {'class': 'form-input'}}) }}
                {{ form_errors(form.firstName) }}
            </div>

            <div class="form-group">
                {{ form_label(form.lastName) }}
                {{ form_widget(form.lastName, {'attr': {'class': 'form-input'}}) }}
                {{ form_errors(form.lastName) }}
            </div>
        </div>

        <div class="form-group">
            {{ form_label(form.birthDate) }}
            {{ form_widget(form.birthDate, {'attr': {'class': 'form-input'}}) }}
            {{ form_errors(form.birthDate) }}
        </div>

        <div class="form-group">
            {{ form_label(form.team) }}
            {{ form_widget(form.team, {'attr': {'class': 'form-select'}}) }}
            {{ form_errors(form.team) }}
        </div>

        <div class="form-group">
            {{ form_label(form.positions) }}
            {{ form_widget(form.positions, {'attr': {'class': 'form-multiselect'}}) }}
            {{ form_errors(form.positions) }}
        </div>

        <div class="form-actions">
            {{ form_widget(form.submit, {'attr': {'class': 'btn-submit'}}) }}
        </div>
        {{ form_end(form) }}
    </section>
{% endblock %}
