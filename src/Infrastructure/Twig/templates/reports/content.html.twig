<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 8px;
            margin: 0;
            padding: 8px;
            line-height: 1.2;
        }

        .main-layout {
            width: 100%;
            border-collapse: collapse;
        }

        /* Terrains sur les côtés */
        .field-left, .field-right {
            width: 140px;
            vertical-align: top;
            padding: 5px;
        }

        .field-diagram {
            width: 130px;
            height: 90px;
            background-color: #90EE90;
            position: relative;
            border: 2px solid #333;
            margin-bottom: 10px;
        }

        .penalty-box {
            width: 35px;
            height: 25px;
            border: 1px solid #333;
            position: absolute;
        }

        .penalty-box-left {
            left: 0;
            top: 32px;
        }

        .penalty-box-right {
            right: 0;
            top: 32px;
        }

        .center-circle {
            width: 30px;
            height: 30px;
            border: 1px solid #333;
            border-radius: 50%;
            position: absolute;
            left: 50px;
            top: 30px;
        }

        .center-line {
            position: absolute;
            left: 65px;
            top: 0;
            bottom: 0;
            border-left: 1px solid #333;
        }

        .player-number {
            position: absolute;
            font-weight: bold;
            font-size: 9px;
            background-color: white;
            padding: 1px;
            border-radius: 50%;
            width: 14px;
            height: 14px;
            text-align: center;
            line-height: 14px;
            border: 1px solid #333;
        }

        /* Section centrale */
        .center-content {
            vertical-align: top;
            padding: 10px;
        }

        .match-header {
            text-align: center;
            font-weight: bold;
            font-size: 12px;
            margin-bottom: 15px;
            background-color: #90EE90;
            padding: 8px;
        }

        .top-comments {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 5px;
        }

        .comment-cell {
            width: 33.33%;
            padding-left: 8px;
            padding-right: 8px;
            padding-top: 4px;
            vertical-align: top;
            border: 1px solid #333;
            font-size: 7px;
        }

        .match-info-cell {
            text-align: center;
            font-weight: bold;
            background-color: #f0f0f0;
        }

        .score-section {
            text-align: center;
            margin: 15px 0;
            font-size: 9px;
        }

        /* Section joueurs */
        .players-section {
            width: 100%;
            border-collapse: collapse;
        }

        .team-players {
            width: 50%;
            vertical-align: top;
            padding: 8px;
            border: 1px solid #333;
        }

        .team-header {
            background-color: #90EE90;
            text-align: center;
            padding: 5px;
            font-weight: bold;
            font-size: 8px;
            margin-bottom: 8px;
        }

        .player-list {
            font-size: 7px;
            line-height: 1.3;
        }

        .player-entry {
            margin-bottom: 3px;
            padding: 2px 0;
        }

        .substitutes {
            margin-top: 15px;
            font-size: 7px;
            border-top: 1px solid #999;
            padding-top: 8px;
        }

        /* Tableaux des joueurs */
        .players-grid {
            width: 100%;
            border-collapse: collapse;
            font-size: 7px;
        }

        .player-cell {
            border: 1px solid #333;
            padding: 5px;
            vertical-align: top;
            width: 50%;
        }

        .player-name {
            font-weight: bold;
            margin-bottom: 3px;
        }

        .player-comment {
            line-height: 1.2;
        }

        /* Section remplaçants */
        .substitutes-section {
            margin-top: 15px;
        }

        .substitutes-grid {
            width: 100%;
            border-collapse: collapse;
            font-size: 7px;
        }

        .substitute-cell {
            border: 1px solid #666;
            padding: 4px;
            vertical-align: top;
            width: 50%;
        }

        /* Events section */
        .events-section {
            margin: 15px 0;
            padding: 8px;
            border: 1px solid #333;
            font-size: 7px;
        }

        .events-row {
            width: 100%;
            border-collapse: collapse;
        }

        .event-column {
            width: 33.33%;
            vertical-align: top;
            padding: 5px;
            border-right: 1px solid #999;
        }

        .event-header {
            font-weight: bold;
            margin-bottom: 5px;
            text-decoration: underline;
        }

        /* Commentaires finaux - GARDE IDENTIQUE */
        .comments-final {
            width: 96.5%;
            border: 1px solid #333;
            padding: 8px;
            margin-left: 1%;
            font-size: 7px;
        }

        .bold {
            font-weight: bold;
        }
    </style>
</head>
<body>

<table class="main-layout">
    <tr>
        <!-- CONTENU CENTRAL -->
        <td class="center-content">
            <!-- Commentaires du haut -->
            <table class="top-comments">
                <tr>
                    <td class="comment-cell">
                        <div class="bold">Remarque sur l'équipe domicile</div><br>
                        {{ matchInfos.homeTeamInfo|nl2br }}
                    </td>
                    <td class="comment-cell match-info-cell">
                        <div class="bold">{{ homeTeamName }} vs {{ awayTeamName }}</div><br>
                        J02 {{ competitionName }}<br>
                        {{ dateMatch }}<br>
                        {{ stadiumName }}

                        <hr>

                        <div class="bold">Remarque avant-match</div><br>
                        {{ matchInfos.preMatchInfo }}
                    </td>
                    <td class="comment-cell">
                        <div class="bold">Remarque sur l'équipe visiteuse</div><br>
                        {{ matchInfos.awayTeamInfo|nl2br }}
                    </td>
                </tr>
            </table>

            <!-- Section joueurs -->
            <table class="players-section">
                <tr>
                    <td class="team-players">
                        <div class="team-header">ÉQUIPE DOMICILE - {{ homeTeamName }}</div>

                        <!-- Tableau des 11 titulaires -->
                        <table class="players-grid">
                            {% for playerViewModels in homePlayers|batch(2) %}
                                <tr>
                                    {% for playerVM in playerViewModels %}
                                        <td class="player-cell">
                                            <div class="player-name"><span class="bold">{{ playerVM.numero }} - {{ playerVM.name }}</span> {{ playerVM.year }}</div>
                                            {% for note in playerVM.notes %}
                                                {{ note.content }} ({{ note.minute }}') |
                                            {% endfor %}
                                        </td>
                                    {% endfor %}
                                </tr>
                            {% endfor %}
                        </table>

                        <!-- Section remplaçants -->
                        <div class="substitutes-section">
                            <div class="team-header" style="margin-top: 10px;">Banc des remplaçants</div>
                            <table class="substitutes-grid">
                                {% for substituteViewModels in homeSubstitutes|batch(2) %}
                                    <tr class="player-cell">
                                        {% for substituteVM in substituteViewModels %}
                                            <td class="player-cell">
                                                <div class="player-name"><span class="bold">{{ substituteVM.numero }} - {{ substituteVM.name }}</span> {{ substituteVM.year }}</div>
                                                {% for note in substituteVM.notes %}
                                                    {{ note.content }} ({{ note.minute }}') |
                                                {% endfor %}
                                            </td>
                                        {% endfor %}
                                    </tr>
                                {% endfor %}
                            </table>
                        </div>
                    </td>

                    <td class="team-players">
                        <div class="team-header">ÉQUIPE EXTÉRIEUR - {{ awayTeamName }}</div>

                        <!-- Tableau des 11 titulaires -->
                        <table class="players-grid">
                            {% for playerViewModels in awayPlayers|batch(2) %}
                                <tr>
                                    {% for playerVM in playerViewModels %}
                                        <td class="player-cell">
                                            <div class="player-name"><span class="bold">{{ playerVM.numero }} - {{ playerVM.name }}</span> {{ playerVM.year }}</div>
                                            {% for note in playerVM.notes %}
                                                {{ note.content }} ({{ note.minute }}') |
                                            {% endfor %}
                                        </td>
                                    {% endfor %}
                                </tr>
                            {% endfor %}
                        </table>

                        <!-- Section remplaçants -->
                        <div class="substitutes-section">
                            <div class="team-header" style="margin-top: 10px;">Banc des remplaçants</div>
                            <table class="substitutes-grid">
                                {% for substituteViewModels in awaySubstitutes|batch(2) %}
                                    <tr class="player-cell">
                                        {% for substituteVM in substituteViewModels %}
                                            <td class="player-cell">
                                                <div class="player-name"><span class="bold">{{ substituteVM.numero }} - {{ substituteVM.name }}</span> {{ substituteVM.year }}</div>
                                                {% for note in substituteVM.notes %}
                                                    {{ note.content }} ({{ note.minute }}') |
                                                {% endfor %}
                                            </td>
                                        {% endfor %}
                                    </tr>
                                {% endfor %}
                            </table>
                        </div>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>

<!-- SECTION COMMENTAIRES FINAUX  -->
<div class="comments-final">
    {{ matchInfos.postMatchInfo|nl2br }}
</div>

</body>
</html>
