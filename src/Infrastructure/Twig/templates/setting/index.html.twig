{% extends 'base.html.twig' %}

{% block title %}Joueurs{% endblock %}

{% block body %}

    <div class="head-page mt-8">
        <h3></h3>
        <h2 class="text-3xl  font-bold text-center">Paramètres</h2>
    </div>

    {% for message in app.flashes('error') %}
        <div class="flash-notice" style="color: red; margin-top: 4%; margin-left: auto; padding: 1%; border-radius: 1rem; margin-right: auto; text-align: center; width: 50%;">
            {{ message }}
        </div>
    {% endfor %}

    <div class="overflow-x-auto mt-8">
        <table class="table table-zebra">
            <thead>
            <tr>
                <th></th>
                <th>Identifiant</th>
                <th>Email</th>
                <th>Roles</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for user in viewModel.users %}
                <tr>
                    <th>{{ user.positionLoop }}</th>
                    <td>{{ user.identifier }}</td>
                    <td>{{ user.email }}</td>
                    <td>
                        {% for role in user.roles %}
                                {{ role }}
                        {% endfor %}
                    </td>
                    <td>
                        <a href="{{ path('delete_user', { idUser: user.id }) }}"
                           data-controller="confirm"
                           data-action="click->confirm#confirm"
                           data-confirm-message-value="Es-tu sûr de vouloir supprimer cet utilisateur ? Cette action est irréversible.">
                            <i class="fa-solid fa-trash text-red-600"></i>
                        </a>
                        <a href="{{ path('edit_user', { idUser: user.id }) }}">
                            <i class="fa-solid fa-pencil"></i>
                        </a>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

{% endblock %}
