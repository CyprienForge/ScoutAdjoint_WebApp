{% block body %}
    <div class="card bg-base-200 w-96 shadow-sm">
        <figure>
            <img
                src="https://pafc.fr/wp-content/uploads/2018/12/U17-National-400x364.jpg"
                alt="Logo of championship"/>
        </figure>
        <div class="card-body">
            <h2 class="card-title">
                RCSA U17 vs ESTAC U17
                <div class="badge badge-secondary">NEW</div>
            </h2>
            <p>Finale CNU17 - Le Puy-en-Velay</p>
            <div class="card-actions justify-end">
                <div class="badge badge-outline">Détails de la rencontre</div>
            </div>
        </div>
    </div>
{% endblock %}
