<turbo-frame id="participations-frame">
    <section id="participations" style="display: flex; justify-content: end; flex-wrap: wrap;">
        {% for player in notesViewModels %}
            <div id="participation"
                 class="bg-base-200"
                 onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 8px 16px rgba(0,0,0,0.08)'"
                 onmouseout="this.style.transform=''; this.style.boxShadow='0 4px 8px rgba(0,0,0,0.05)'">

                <a href="{{ path('details_player', { idPlayer: player.idPlayer }) }}" style="display: block; text-decoration: none; color: inherit;">
                    <div id="infos-player">
                        <h3>
                            {{ player.firstName }} {{ player.lastName }}
                        </h3>
                        <h3>
                            N°{{ player.numero }}
                            -
                            ({{ player.birthYear }})
                        </h3>
                    </div>
                </a>

                <div style="padding-left: 8px;">
                    {% for note in player.notes %}
                        <p id="notes">
                            <span>{{ note.minute }}'</span> – <span id="content">{{ note.content }}</span>
                        </p>
                    {% endfor %}
                </div>
            </div>
        {% endfor %}
    </section>
</turbo-frame>
