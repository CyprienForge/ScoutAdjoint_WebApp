<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('build/app.css') }}">
            <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body style="display: flex">
        <div id="menu" class="bg-base-200 w-1/6 h-screen">
            <h3 class="text-3xl font-bold mt-4 text-center">ScoutAdjoint</h3>
            <aside>
                <ul class="pt-8 text-center mt-8 font-semibold">
                    <li>
                        <a href="{{ path('home') }}">Accueil</a>
                    </li>
                    <li class="mt-8">
                        <a href="{{ path('get_players') }}">Joueurs</a>
                    </li>
                    <li class="mt-8">
                        <a href="{{ path('get_matchs') }}">Matchs</a>
                    </li>
                </ul>
            </aside>
        </div>
        <div id="content" class="w-3/4">
            {% block body %}{% endblock %}
        </div>
    </body>
</html>
