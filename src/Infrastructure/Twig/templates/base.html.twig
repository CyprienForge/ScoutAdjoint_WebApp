<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}ScoutAdjoint{% endblock %}</title>

        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('build/app.css') }}">
            <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body style="display: flex">
        <div id="menu" class="bg-base-200 w-1/6 h-screen">
            <h3 class="text-3xl font-bold mt-4 text-center">ScoutAdjoint</h3>
            {% set current_route = app.request.attributes.get('_route') %}

            <aside>
                {% if current_route != 'login_page' %}
                    <ul class="pt-8 text-center font-semibold">
                        <li>
                            {% if global_vm().isAuthenticated %}
                                <form method="post" action="{{ path('logout') }}">
                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                                    <button type="submit" class="btn btn-info btn-soft">
                                        Se déconnecter
                                    </button>
                                </form>
                            {% else %}
                                <a class="btn btn-info btn-soft" href="{{ path('login_page') }}">
                                    Se connecter
                                </a>
                            {% endif %}

                            <br>
                            <span>
                    {{ global_vm().isAuthenticated ? 'Connecté en tant que ' ~ global_vm().identifier : '' }}
                </span>
                        </li>
                        <li class="mt-8">
                            <a href="{{ path('home') }}">🏠 Accueil</a>
                        </li>
                        {% if is_granted('ROLE_SCOUT') %}
                            <li class="mt-8">
                                <a href="{{ path('get_players') }}">🦶 Joueurs</a>
                            </li>
                            <li class="mt-8">
                                <a href="{{ path('get_matchs') }}">⚽ Matchs</a>
                            </li>
                            <li class="mt-8">
                                <a href="{{ path('get_teams') }}">👥 Équipes</a>
                            </li>
                        {% endif %}
                        {% if is_granted('ROLE_CHIEF_SCOUT') %}
                            <li class="mt-8">
                                <a href="{{ path('settings') }}" class="font-semibold">⚙️ Paramètres</a>
                            </li>
                        {% endif %}
                    </ul>
                {% endif %}
            </aside>

        </div>
        <div id="content" class="w-3/4">
            {% block body %}
            {% endblock %}
        </div>
    </body>
</html>
